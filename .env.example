# Anthropic API Key for conversation-risk analysis
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model configuration
ANTHROPIC_MODEL=claude-sonnet-5
SPOOF_MODEL_NAME=MelodyMachine/Deepfake-audio-detection-V2
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Privacy settings
DELETE_AUDIO_AFTER_PROCESSING=true

# Server configuration
HOST=0.0.0.0
PORT=8000